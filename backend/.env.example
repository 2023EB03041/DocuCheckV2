# Copy this file to .env and fill in real values. Never commit .env.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Secret used to sign and verify JWTs — use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# API key for document extraction. Generate one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for document extraction. The 2.x line is closed to new keys.
GEMINI_MODEL=gemini-3.5-flash-lite

# Credentials for government record verification (https://sandbox.co.in).
# Only test credentials are supported — they are free, answer from published
# sample records, and never carry a real person's details. A key_live key is
# refused rather than used.
SANDBOX_API_KEY=key_test_your_key_here
SANDBOX_API_SECRET=secret_test_your_secret_here

# Fixed one-time password the sample Aadhaar records are published with. It lets
# the server complete an Aadhaar check on its own, so the guest is never asked
# for a password.
AADHAAR_DEV_OTP=121212

# Sites a browser may call this API from, comma separated. Leave unset to allow
# the hosted front end and the local dev server.
CORS_ORIGINS=

# Documents that no government record confirms are rejected and the guest is
# asked to upload another ID. Set to false only if verification is unavailable
# and readings have to be accepted on their own.
REQUIRE_GOVERNMENT_VERIFICATION=true
